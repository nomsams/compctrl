{
  "name": "compctrl",
  "productName": "CompCtrl",
  "version": "0.5.0",
  "description": "Peer-to-peer phone controller for Windows",
  "author": "CompCtrl contributors",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build --base=/",
    "build:pages": "vite build",
    "verify:desktop-bundle": "node scripts/verify-desktop-bundle.mjs",
    "companion": "electron companion/main.cjs",
    "pack:windows": "npm run build:desktop && npm run verify:desktop-bundle && node scripts/create-integrity-manifest.mjs && electron-builder --win nsis portable --publish never && node scripts/create-checksums.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test:geometry": "node --experimental-strip-types --test lib/*.test.ts companion/*.test.cjs",
    "test:capture:windows": "electron scripts/capture-smoke.cjs --disable-wgc --strict-permissions --webrtc-loopback",
    "test:rendezvous": "electron scripts/rendezvous-smoke.cjs",
    "test:installed-session": "electron scripts/installed-session-smoke.cjs",
    "test:local-whisper": "node scripts/local-whisper-smoke.cjs",
    "lint": "oxlint app lib",
    "format": "oxfmt"
  },
  "main": "companion/main.cjs",
  "build": {
    "appId": "app.compctrl.desktop",
    "productName": "CompCtrl",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "companion/**/*",
      "!companion/*.test.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/client",
        "to": "web"
      },
      {
        "from": "companion/native-bridge.ps1",
        "to": "native-bridge.ps1"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "CompCtrl-Setup-${version}-${arch}.${ext}",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "CompCtrl-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "peerjs": "^1.5.5",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-day-picker": "9.8.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.0",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "electron": "44.3.0",
    "electron-builder": "^26.0.12",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.131.1"
  },
  "type": "module",
  "allowScripts": {
    "electron@44.3.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.4": true,
    "workerd@1.20260911.1": true
  }
}
